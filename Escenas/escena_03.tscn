[node name="NotaCientifico" parent="." unique_id=1060634678 instance=ExtResource("15_nota_cientifico")]
codigo_nivel = "NIVEL 03 — NÚCLEO ELECTROMAGNÉTICO (MISIÓN CRÍTICA)"
titulo_tema = "ELECTROMAGNETISMO + MISIÓN CRÍTICA"
subtitulo_mision = "Calibra electroimanes, generadores de Faraday y recupera los archivos clasificados."
formulas_clave = PackedStringArray("Electroimán / Bobina:  B = μ₀ · (N / L) · I", "Inducción de Faraday:  ε = -N · (ΔΦ / Δt)")
texto_explicacion = "Atención, soldado, llegaste al núcleo subterráneo. Aquí se guardan los archivos clasificados que vinimos a buscar. Todo este sector funciona con Electromagnetismo: al pasar corriente por las bobinas activas electroimanes capaces de mover puentes metálicos, y al mover imanes generas corriente inducida para encender los generadores."
alerta_mision = "⚠ OBJETIVO PRINCIPAL: Busca el estante de archivos clasificados en este nivel y presiona [E] para recuperarlos. Sin esos documentos en tu poder, la compuerta de salida no se abrirá."
ruta_audio_voz = "res://assets/audio/voces/voz_nivel_3.mp3"

