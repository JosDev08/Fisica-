[sub_resource type="GDScript" id="GDScript_meta_final"]
script/source = "extends Area2D

var completado: bool = false
var jugador_cerca: bool = false
var _tecla_e_prev: bool = false

func _ready() -> void:
	monitoring = true
	monitorable = true
	collision_layer = 0
	collision_mask = 1
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)

func _process(_delta: float) -> void:
	if completado:
		return
	var detectado := false
	if monitoring:
		for b in get_overlapping_bodies():
			if b.is_in_group(\"jugador\") or b is CharacterBody2D or b.name == \"Jugador\":
				detectado = true
				break
	if detectado != jugador_cerca:
		jugador_cerca = detectado
		_actualizar_aviso()
	var e_actual := Input.is_physical_key_pressed(KEY_E) or Input.is_key_pressed(KEY_E)
	if e_actual and not _tecla_e_prev and jugador_cerca:
		_completar_nivel()
	_tecla_e_prev = e_actual

func _unhandled_input(event: InputEvent) -> void:
	if completado or not jugador_cerca:
		return
	if event is InputEventKey and event.pressed and not event.echo and (event.physical_keycode == KEY_E or event.keycode == KEY_E):
		get_viewport().set_input_as_handled()
		_completar_nivel()

func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"jugador\") or body is CharacterBody2D or body.name == \"Jugador\":
		jugador_cerca = true
		_actualizar_aviso()
		_completar_nivel()

func _on_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"jugador\") or body is CharacterBody2D or body.name == \"Jugador\":
		jugador_cerca = false
		_actualizar_aviso()

func _actualizar_aviso() -> void:
	if completado:
		return
	var etiqueta := get_node_or_null(\"AvisoMeta\") as Label
	if etiqueta:
		etiqueta.text = \"[E] Interactuar — PORTAL DE EXTRACCIÓN\" if jugador_cerca else \"PORTAL DE EXTRACCIÓN\"

func _completar_nivel() -> void:
	if completado:
		return
	completado = true
	if Engine.has_singleton(\"GameManager\") or get_node_or_null(\"/root/GameManager\") != null:
		GameManager.completar_meta_nivel(\"\", global_position)
	print(\"¡Nivel Final Completado!\")
	var etiqueta := get_node_or_null(\"AvisoMeta\") as Label
	if etiqueta:
		etiqueta.text = \"¡NIVEL FINAL COMPLETADO!\"
		etiqueta.modulate = Color(0.4, 1.0, 0.55, 1.0)
"

