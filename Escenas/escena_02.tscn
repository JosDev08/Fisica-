[node name="NotaCientifico" parent="." unique_id=1788696188 instance=ExtResource("36_nota_cientifico")]
codigo_nivel = "NIVEL 02 — BANCO DE ALMACENAMIENTO ELÉCTRICO"
titulo_tema = "CAPACITORES Y ENERGÍA ELÉCTRICA"
subtitulo_mision = "Configura capacitores en serie y paralelo para alimentar puentes y elevadores."
formulas_clave = PackedStringArray("Carga eléctrica:  Q = C · V", "En paralelo (se suman):  C_eq = C₁ + C₂", "En serie (disminuyen):  1/C_eq = 1/C₁ + 1/C₂", "Energía almacenada:  U = ½ · C · V²")
texto_explicacion = "Bien hecho, soldado, lograste entrar al sector interno. Estás cada vez más cerca de la bóveda, pero los pasillos están sellados con bancos de capacitores. Estos dispositivos almacenan energía eléctrica para alimentar compuertas y elevadores. Ten esto en mente para avanzar: si conectas capacitores en paralelo, sumas su capacidad para dar más potencia; si los pones en serie, la capacidad total baja. Además, a mayor voltaje, mucha más energía acumulada. Carga los sistemas y ábrete camino hacia el subsuelo."
ruta_audio_voz = "res://assets/audio/voces/voz_nivel_2.mp3"
